                pcState[pc] = nil
            end
        end
    end
    
    local function watchPC(pc)
        if hookedPCs[pc] then return end
        hookedPCs[pc] = true
        local scr = pc:FindFirstChild("Screen")
        if scr and scr:IsA("BasePart") then
            applyScreenState(pc, scr.Color)

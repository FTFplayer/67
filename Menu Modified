            local isBeast = stats:FindFirstChild("IsBeast")
            if isBeast then
                if isBeast.Value == true then
                    currentShowDist = SHOW_DISTANCE_BEAST
                else
                    currentShowDist = SHOW_DISTANCE_SURV
                end
            end
        end
    end
    
    local function watchStats()

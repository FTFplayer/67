ad\n    local scaleX = math.abs(math.cos(angle)) > 1e-6 and halfW / math.abs(math.cos(angle)) or math.huge\n    local scaleY = math.abs(math.sin(angle)) > 1e-6 and halfH / math.abs(math.sin(angle)) or math.huge\n    local dist   = math.min(scaleX, scaleY)\n    local tip    = center + dir * dist\n\n    local perp   = Vector2.new(-dir.Y, dir.X)\n    local base1  = tip - dir * (size * 1.8) + perp * size\n    local base2  = tip - dir * (size * 1.8) - perp * size\n\n    local ol = 2\n    local oTip   = tip   + dir  * ol\n    local oBase1 = base1 - dir  * ol + perp * ol\n    local oBase2 = base2 - dir  * ol - perp * ol\n\n    arrow.outline.PointA  = oTip\n    arrow.outline.PointB  = oBase1\n    arrow.outline.PointC  = oBase2\n    arrow.outline.Visible = a.OutlinesEnabled\n\n    arrow.fill.PointA  = tip\n    arrow.fill.PointB  = base1\n    arrow.fill.PointC  = base2\n    arrow.fill.Color   = color\n    arrow.fill.Visible = true\n\n    return true\nend\n\n-- \9472\9472 CONSTANTS \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\nlocal MAX_CIRCLE_SEGS = 64  -- pool at max possible segments\nlocal MAX_GLOBE_RINGS = 4\nlocal MAX_GLOBE_SEGS  = 64\n\nlocal y = {}\ny.__index = y\n\nfunction y.new(t)\n    local self = setmetatable({}, y)\n    self.Player = t\n\n    -- \9472\9472 BOX (Full mode) \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\n    self.BoxLines = {} self.BoxOutlines = {}\n    for i = 1, 4 do\n        local ol = Drawing.new(\"Line\", DrawingFlag) ol.Thickness = a.BoxThickness + 2 o
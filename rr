2\9472\9472\9472\n    self.GlobeLines    = {}\n    self.GlobeOutlines = {}\n    for ring = 1, MAX_GLOBE_RINGS do\n        self.GlobeLines[ring]    = {}\n        self.GlobeOutlines[ring] = {}\n        for seg = 1, MAX_GLOBE_SEGS do\n            local ol = Drawing.new(\"Line\", DrawingFlag)\n            ol.Thickness = a.GlobeThickness + 2\n            ol.Color     = Color3.new(0, 0, 0)\n            ol.ZIndex    = 0\n            ol.Visible   = false\n            self.GlobeOutlines[ring][seg] = ol\n\n            local ln = Drawing.new(\"Line\", DrawingFlag)\n            ln.Thickness = a.GlobeThickness\n            ln.Visible   = false\n            self.GlobeLines[ring][seg] = ln\n        end\n    end\n\n    return self\nend\n\nlocal InstanceNew = Instance.new\nlocal CFrameNew = CFrame.new\nlocal Vec3 = Vector3.new\n\nlocal function RemoveAdorns(Part)\n    if not Part then return end\n    for _, Obj in ipairs(Part:GetChildren()) do\n        if Obj.Name == \"Chams\" or Obj.Name == \"Glow\" then Obj:Destroy() end\n    end\nend\n\nlocal function CreateAdornment(Part, Type, Color, Trans, ZIndex, SizeOffset, Extra)\n    Extra = Extra or {}\n    local Ad\n    if Type == \"Cylinder\" then\n        Ad = InstanceNew(\"CylinderHandleAdornment\")\n        Ad.Height = Part.Size.Y + (Extra.HeightOffset or 0)\n        Ad.Radius = (Part.Size.X * 0.5) + (Extra.RadiusOffset or 0)\n        Ad.CFrame = CFrameNew(Vec3(), Vec3(0,1,0))\n    elseif Type == \"Box\" then\n        Ad = InstanceNew(\"BoxHandleAdornment\")\n        Ad.Size = Part.Size + (SizeOffset or Vec3.zero)\n    end\n    Ad.Name = \"Chams\"\n    Ad.AlwaysOnTop = true\n    Ad.ZIndex = ZIndex\n    Ad.Adornee = Part\n    Ad.Color3 = Color\n    Ad.Transparency = Trans or 0\n    if Extra.Shading then Ad.Shading = Extra.Shading end\n    Ad.Parent = Part\n    return Ad\nend\n\nfunction y:ClearGlowChams()\n    for _, adorn in ipairs(self.GlowChams) do if adorn and adorn.Parent then adorn:Destroy() end end\n    table.clear(self.GlowChams)\nend\n\nfunction y:UpdateGlowChams(color)\n    self:ClearGlowChams()\n    if not a.GlowChamsEnabled then return end\n    local Char = self.Player.Character\n    if not Char then return end\n    for _, Part in ipairs(Char:GetChildren()) do\nlocal __DARKLUA_CONTINUE_11=false repeat        if not Part:IsA(\"BasePart\") or Part.Transparency >= 1 then __DARKLUA_CONTINUE_11=true break end\n        RemoveAdorns(Part)\n        local IsHead = Part.Name == \"Head\" or Part.Name == \"FakeHead\"\n        local Glow = CreateAdornment(Part, IsHead and \"Cylinder\" or \"Box\", Color3.new(color.R * a.GlowMultiplier, color.G * a.GlowMultiplier, color.B * a.GlowMultiplier), -1, IsHead and 10 or 9, a.GlowSizeOffset, {Shading = Enum.AdornShading.XRayShaded})\n        table.insert(self.GlowChams, Glow)\n        local Main = CreateAdornment(Part, IsHead and \"Cylinder\" or \"Box\", color, a.GlowTransparency, 10, a.GlowSizeOffset)\n        table.insert(self.GlowChams, Main)\n__DARKLUA_CONTINUE_11=true until true if not __DARKLUA_CONTINUE_11 then break end    end\nend\n\n-- \9472\9472 HideCircle / HideGlobe helpers \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\nfunction y:HideCircle()\n    for i = 1, MAX_CIRCLE_SEGS do\n        self.CircleLines[i].Visible    = false\n        self.CircleOutlines[i].Visible = false\n    end\nend\n\nfunction y:HideGlobe()\n    for ring = 1, MAX_GLOBE_RINGS do\n        for seg = 1, MAX_GLOBE_SEGS do\n            self.GlobeLines[ring][seg].Visible    = false\n            self.GlobeOutlines[ring][seg].Visible = false\n        end\n    end\nend\n\nfunction y:SetVisible(v)\n    local isFull   = a.BoxMode == \"Full\"    or a.BoxMode == \"Both\"\n    local isCorner = a.BoxMode == \"Corners\" or a.BoxMode == \"Both\"\n    local is3D     = a.BoxMode == \"3D\"\n\n    -- Full box lines\n    for i = 1, 4 do\n        self.BoxLines[i].Visible    = v and a.BoxEnabled and isFull\n        self.BoxOutlines[i].Visible = v and a.BoxEnabled and isFull and a.OutlinesEnabled\n    end\n\n    -- Corners (16 squares)\n    for i = 1, 16 do\n        local show = v and a.BoxEnabled and isCorner\n        -- outline squares (1-8) also respect OutlinesEnabled\n        self.Corners[i].Visible = show and (i > 8 or a.OutlinesEnabled)\n    end\n\n    -- 3D box lines\n    for i = 1, 12 do\n        self.Box3D[i].Visible        = v and a.BoxEnabled and is3D\n        self.Box3DOutlines[i].Visible = v and a.BoxEnabled and is3D and a.OutlinesEnabled\n    end\n\n    self.BoxFill.Visible = v and a.BoxFillEnabled and (isFull or isCorner) and a.BoxEnabled\n\n    for i = 1, MAX_BONES do\n        self.SkelLines[i].Visible    = v and a.SkeletonEnabled\n        self.SkelOutlines[i].Visible = v and a.SkeletonEnabled and a.OutlinesEnabled\n    end\n\n    self.Name.Visible          = v and a.NameEnabled\n    self.Name.Outline          = a.OutlinesEnabled\n    self.Tracer.Visible        = v and a.TracerEnabled\n    self.TracerOutline.Visible = v and a.TracerEnabled and a.OutlinesEnabled\n    self.ViewTracer.Visible    = v and a.ViewTracerEnabled\n    self.Highlight.Enabled     = v and a.HighlightP\n    self.Trail.Enabled         = v and a.TrailEnabled\n\n    if not v then\n        if self.ArrowIndex then HideArrow(self.ArrowIndex) end\n        self:HideCircle()\n        self:HideGlobe()\n    end\nend\n\nlocal nextArrowIdx = 0\nlocal function GetArrowIndex(self)\n    if not self.ArrowIndex then\n        nextArrowIdx = nextArrowIdx + 1\n        self.ArrowIndex = nextArrowIdx\n    end\n    return self.ArrowIndex\nend\n\n-- \9472\9472 DrawGroundCircle \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\n-- Projects a horizontal circle at the player's feet into screen space and\n-- draws it as line segments.  Links to espColor automatically.\nfunction y:DrawGroundCircle(hrp, espColor)\n    if not a.CircleEnabled then\n        self:HideCircle()\n        return\n    end\n\n    local segs    = math.clamp(math.floor(a.CircleSegments), 3, MAX_CIRCLE_SEGS)\n    local radius  = a.CircleRadius\n    local yOffset = a.CircleYOffset\n    local origin  = hrp.Position + Vector3.new(0, yOffset, 0)\n    local tau     = math.pi * 2\n\n    for i = 1, segs do\n        local t0 = (i - 1) / segs * tau\n        local t1 = i       / segs * tau\n\n        local w0 = origin + Vector3.new(math.cos(t0) * radius, 0, math.sin(t0) * radius)\n        local w1 = origin + Vector3.new(math.cos(t1) * radius, 0, math.sin(t1) * radius)\n\n        local s0 = WorldToScreen(w0)\n        local s1 = WorldToScreen(w1)\n\n        if s0 and s1 then\n            self.CircleLines[i].From    = s0\n            self.CircleLines[i].To      = s1\n            self.CircleLines[i].Color   = espColor\n            self.CircleLines[i].Thickness = a.CircleThickness\n            self.CircleLines[i].Visible = true\n\n            self.CircleOutlines[i].From    = s0\n            self.CircleOutlines[i].To      = s1\n            self.CircleOutlines[i].Thickness = a.CircleThickness + 2\n            self.CircleOutlines[i].Visible = a.OutlinesEnabled\n        else\n            self.CircleLines[i].Visible    = false\n            self.CircleOutlines[i].Visible = false\n        end\n    end\n\n    -- hide unused pool slots\n    for i = segs + 1, MAX_CIRCLE_SEGS do\n        self.CircleLines[i].Visible    = false\n        self.CircleOutlines[i].Visible = false\n    end\nend\n\n-- \9472\9472 DrawGlobe \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\n-- Draws MAX up to 4 latitudinal rings spaced evenly across the sphere,\n-- using GlobeColor (independent of espColor so it can be set separately).\n-- Each ring is projected per-segment into screen space.\nfunction y:DrawGlobe(hrp, espColor)\n    if not a.GlobeEnabled then\n        self:HideGlobe()\n        return\n    end\n\n    local rings   = math.clamp(math.floor(a.GlobeRings), 1, MAX_GLOBE_RINGS)\n    local segs    = math.clamp(math.floor(a.GlobeSegments), 3, MAX_GLOBE_SEGS)\n    local radius  = a.GlobeRadius\n    local tau     = math.pi * 2\n    local origin  = hrp.Position\n    local color   = a.GlobeColor\n\n    -- evenly space rings from slightly below equator to slightly above;\n    -- rings = 1 \8594 equator only; rings = 3 \8594 bottom, middle, top bands; etc.\n    for ring = 1, rings do\n        -- map ring index to an angle from -pi/2 to pi/2 (bottom pole to top pole)\n        -- skip the very poles as they collapse to a point\n        local t = rings == 1 and 0 or ((ring - 1) / (rings - 1) * math.pi - math.pi / 2)\n        local ringRadius = radius * math.cos(t)  -- horizontal radius at this latitude\n        local ringY      = radius * math.sin(t)  -- height offset from center\n\n        -- optional: fade thickness for rings far from equator\n        local thicknessMod = 1\n        if a.GlobeFadeWithDistance then\n            thicknessMod = math.max(0.4, math.cos(t))\n        end\n\n        for seg = 1, segs do\n            local a0 = (seg - 1) / segs * tau\n            local a1 = seg       / segs * tau\n\n            local w0 = origin + Vector3.new(\n                math.cos(a0) * ringRadius,\n                ringY,\n                math.sin(a0) * ringRadius\n            )\n            local w1 = origin + Vector3.new(\n                math.cos(a1) * ringRadius,\n                ringY,\n                math.sin(a1) * ringRadius\n            )\n\n            local s0 = WorldToScreen(w0)\n            local s1 = WorldToScreen(w1)\n\n            if s0 and s1 then\n                local ln = self.GlobeLines[ring][seg]\n                local ol = self.GlobeOutlines[ring][seg]\n\n                ln.From      = s0\n                ln.To        = s1\n                ln.Color     = color\n                ln.Thickness = math.max(1, a.GlobeThickness * thicknessMod)\n                ln.Visible   = true\n\n                ol.From      = s0\n                ol.To        = s1\n                ol.Thickness = math.max(2, (a.GlobeThickness + 2) * thicknessMod)\n                ol.Visible   = a.OutlinesEnabled\n            else\n                self.GlobeLines[ring][seg].Visible    = false\n                self.GlobeOutlines[ring][seg].Visible = false\n            end\n        end\n\n        -- hide unused pool slots for this ring\n        for seg = segs + 1, MAX_GLOBE_SEGS do\n            self.GlobeLines[ring][seg].Visible    = false\n            self.GlobeOutlines[ring][seg].Visible = false\n        end\n    end\n\n    -- hide unused ring pools\n    for ring = rings + 1, MAX_GLOBE_RINGS do\n        for seg = 1, MAX_GLOBE_SEGS do\n            self.GlobeLines[ring][seg].Visible    = false\n            self.GlobeOutlines[ring][seg].Visible = false\n        end\n    end\nend\n\nfunction y:Update()\n    local C = self.Player.Character\n    if not C then return self:SetVisible(false) end\n\n    local hrp  = C:FindFirstChild(\"HumanoidRootPart\")\n    local hum  = C:FindFirstChild(\"Humanoid\")\n    local head = C:FindFirstChild(\"Head\")\n    if not hrp or not hum or hum.Health <= 0 or not head then return self:SetVisible(false) end\n\n    local dist = (b.CFrame.Position - hrp.Position).Magnitude\n    if dist > a.MaxDistance then\n        self:SetVisible(false)\n        if self.ArrowIndex then HideArrow(self.ArrowIndex) end\n        return\n    end\n\n    local espColor = a.BoxColor\n    if a.BeastCheck and n(C) then espColor = a.BeastColor\n    elseif a.TeamCheck and (e.TeamColor == self.Player.TeamColor) then\n        self:SetVisible(false)\n        if self.ArrowIndex then HideArrow(self.ArrowIndex) end\n        self:ClearGlowChams()\n        return\n    end\n    if a.HighlightClosestPlayer and p() == self.Player then espColor = Color3.new(1,1,1) \nskelColor = Color3.new(1, 1, 1)\n\nend\n\n    -- \9472\9472 ON-SCREEN CHECK \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\n    local vp    = b.ViewportSize\n    local rawSp = b:WorldToViewportPoint((hrp.CFrame * a.CharacterOffset).Position)\n    local sp2   = Vector2.new(rawSp.X, rawSp.Y)\n    local depth = rawSp.Z\n\n    local isOnScreen = depth > 0\n        and rawSp.X >= 0 and rawSp.X <= vp.X\n        and rawSp.Y >= 0 and rawSp.Y <= vp.Y\n\n    -- \9472\9472 OFF-SCREEN ARROW \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\n    if a.OffScreenArrowEnabled and not isOnScreen then\n        local idx = GetArrowIndex(self)\n        DrawOffScreenArrow(idx, hrp.Position, espColor)\n        self:SetVisible(false)\n        self.Highlight.FillTransparency = a.HighlightTrans\n        self.Highlight.Adornee          = C\n        self.Highlight.FillColor        = espColor\n        self.Highlight.OutlineColor     = a.HighlightOutlineColour\n        self.Highlight.Enabled          = a.HighlightP\n        if a.GlowChamsEnabled then self:UpdateGlowChams(espColor) else self:ClearGlowChams() end\n        return\n    elseif not isOnScreen then\n        self:SetVisible(false)\n        return\n    end\n\n    if self.ArrowIndex then HideArrow(self.ArrowIndex) end\n\n    local screenPos = sp2\n\n    local is3D     = a.BoxMode == \"3D\"\n    local isFull   = a.BoxMode == \"Full\"    or a.BoxMode == \"Both\"\n    local isCorner = a.BoxMode == \"Corners\" or a.BoxMode == \"Both\"\n    local topY     = screenPos.Y - 20\n    local bottomY  = screenPos.Y + 20\n\n    -- \9472\9472 3D BOX \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\n    if is3D then\n        local Scale = head.Size.Y / 2\n        local Size  = Vector3.new(2, 3, 1.5) * (Scale * 2)\n\n        local Top1 = b:WorldToViewportPoint((hrp.CFrame * CFrame.new(-Size.X,  Size.Y, -Size.Z)).Position)\n        local Top2 = b:WorldToViewportPoint((hrp.CFrame * CFrame.new(-Size.X,  Size.Y,  Size.Z)).Position)\n        local Top3 = b:WorldToViewportPoint((hrp.CFrame * CFrame.new( Size.X,  Size.Y,  Size.Z)).Position)\n        local Top4 = b:WorldToViewportPoint((hrp.CFrame * CFrame.new( Size.X,  Size.Y, -Size.Z)).Position)\n        local Bot1 = b:WorldToViewportPoint((hrp.CFrame * CFrame.new(-Size.X, -Size.Y, -Size.Z)).Position)\n        local Bot2 = b:WorldToViewportPoint((hrp.CFrame * CFrame.new(-Size.X, -Size.Y,  Size.Z)).Position)\n        local Bot3 = b:WorldToViewportPoint((hrp.CFrame * CFrame.new( Size.X, -Size.Y,  Size.Z)).Position)\n        local Bot4 = b:WorldToViewportPoint((hrp.CFrame * CFrame.new( Size.X, -Size.Y, -Size.Z)).Position)\n\n        local pts = {\n            Vector2.new(Top1.X, Top1.Y), Vector2.new(Top2.X, Top2.Y),\n            Vector2.new(Top3.X, Top3.Y), Vector2.new(Top4.X, Top4.Y),\n            Vector2.new(Bot1.X, Bot1.Y), Vector2.new(Bot2.X, Bot2.Y),\n            Vector2.new(Bot3.X, Bot3.Y), Vector2.new(Bot4.X, Bot4.Y),\n        }\n        local edges
2\9472\9472\9472\9472\9472\n\nlocal function isDoor(obj)\n    return obj.Name == \"SingleDoor\" or obj.Name == \"DoubleDoor\"\nend\n\nlocal function isComputer(obj)\n    return obj.Name == \"ComputerTable\" or obj.Name == \"PrefabComputerTable\"\nend\n\nlocal function isLocker(obj)\n    return obj:HasTag(\"LOCKER\")\nend\n\nlocal function isGreenish(color)\n    local h, s, v = Color3.toHSV(color)\n    return h >= 0.25 and h <= 0.42 and s > 0.3 and v > 0.1\nend\n\nlocal function getScreenColor(computerModel)\n    local screen = computerModel:FindFirstChild(\"Screen\", true)\n    if screen and screen:IsA(\"BasePart\") then\n        return screen.Color\n    end\n    return nil\nend\n\nlocal function getVentTarget(child, map)\n    if child.Parent ~= map and not child.Parent:IsA(\"Folder\") then\n        return child.Parent\n    end\n    return child\nend\n\n-- \9472\9472\9472 ESP Management \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\n\nlocal function clearESP()\n    -- Only clear descendants listeners for the current map, NOT the map change listener!\n    for _, c in ipairs(mapConnections) do \n        c:Disconnect() \n    end\n    mapConnections = {}\n\n    for _, tbl in pairs(espObjects) do\n        for _, esp in pairs(tbl) do\n            if esp then \n                pcall(function() esp:Destroy() end)\n            end\n        end\n    end\n\n    espObjects = {\n        FreezePods  = {},\n        VentBlocks  = {},\n        DoorESP     = {},\n        ComputerESP = {},\n        Lockers     = {},\n    }\nend\n\nlocal function clearCategory(category)\n    for obj, esp in pairs(espObjects[category]) do\n        if esp then \n            pcall(function() esp:Destroy() end)\n        end\n        espObjects[category][obj] = nil\n    end\nend\n\nlocal function addESP(category, obj)\n    if espObjects[category][obj] then return end\n    local cfg = getgenv().PartsESP[category]\n    if not cfg or not cfg.Enabled or not cfg.Highlight then return end\n\n    if category == \"ComputerESP\" then\n        local screenColor = getScreenColor(obj)\n        if screenColor and isGreenish(screenColor) then return end\n    end\n\n    local esp = ESPLibrary:Add({\n        Model           = obj,\n        Color           = cfg.HighlightColor,\n        FillColor       = cfg.HighlightColor,\n        OutlineColor    = cfg.HighlightColor,\n        MaxDistance     = 1000,\n        ESPType         = \"Highlight\",\n        Name            = cfg.Text,\n        ShowDistance    = false,\n        Distance        = false,\n        ShowName        = (cfg.Text ~= nil and cfg.Text ~= \"\"),\n        Text            = cfg.Text,\n    })\n\n    if esp then\n        if esp.CurrentSettings then\n            esp.CurrentSettings.ShowDistance = false\n            esp.CurrentSettings.Distance = false\n        end\n        if esp.Components and esp.Components.Distance then\n            esp.Components.Distance.Visible = false\n        end\n    end\n\n    espObjects[category][obj] = esp\nend\n\nlocal function removeESP(obj)\n    for _, list in pairs(espObjects) do\n        if list[obj] then\n            pcall(function() list[obj]:Destroy() end)\n            list[obj] = nil\n        end\n    end\nend\n\n-- \9472\9472\9472 Map Scan \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\n\nlocal function scanMap()\n    local currentMapObj = ReplicatedStorage:FindFirstChild(\"CurrentMap\")\n    if not currentMapObj then return end\n    \n    local mapValue = currentMapObj.Value\n    local mapName  = typeof(mapValue) == \"Instance\" and mapValue.Name or mapValue\n    if not mapName or mapName == \"\" then return end\n\n    local map = Workspace:FindFirstChild(mapName)\n    if not map then return end\n\n    for _, child in ipairs(map:GetDescendants()) do\n        if getgenv().PartsESP.VentBlocks.Enabled and child.Name == \"VentBlock\" then\n            addESP(\"VentBlocks\", getVentTarget(child, map))\n        elseif getgenv().PartsESP.FreezePods.Enabled  and child.Name == \"FreezePod\"  then addESP(\"FreezePods\",  child)\n        elseif getgenv().PartsESP.DoorESP.Enabled     and isDoor(child)              then addESP(\"DoorESP\",     child)\n        elseif getgenv().PartsESP.ComputerESP.Enabled and isComputer(child)          then addESP(\"ComputerESP\", child)\n        elseif getgenv().PartsESP.Lockers.Enabled     and isLocker(child)            then addESP(\"Lockers\",     child)\n        end\n    end\n\n    table.insert(mapConnections, map.DescendantAdded:Connect(function(child)\n        if getgenv().PartsESP.VentBlocks.Enabled and child.Name == \"VentBlock\" then\n            addESP(\"VentBlocks\", getVentTarget(child, map))\n        elseif getgenv().PartsESP.FreezePods.Enabled  and child.Name == \"FreezePod\"  then addESP(\"FreezePods\",  child)\n        elseif getgenv().PartsESP.DoorESP.Enabled     and isDoor(child)              then addESP(\"DoorESP\",     child)\n        elseif getgenv().PartsESP.ComputerESP.Enabled and isComputer(child)          then addESP(\"ComputerESP\", child)\n        elseif getgenv().PartsESP.Lockers.Enabled     and isLocker(child)            then addESP(\"Lockers\",     child)\n        end\n    end))\n\n    table.insert(mapConnections, map.DescendantRemoving:Connect(removeESP))\nend\n\n-- \9472\9472\9472 Persistent Round / Map Change Listener \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\n\nlocal function OnNewRound()\n    clearESP()\n    for category in pairs(lastEnabledState) do\n        lastEnabledState[category] = false\n    end\n\n    -- Wait until the new map is physically parented in Workspace\n    local currentMapObj = ReplicatedStorage:FindFirstChild(\"CurrentMap\")\n    if currentMapObj then\n        local attempts = 0\n        while attempts < 20 do\n            task.wait(0.2)\n            local mapVal = currentMapObj.Value\n            local name = typeof(mapVal) == \"Instance\" and mapVal.Name or mapVal\n            if name and name ~= \"\" and Workspace:FindFirstChild(name) then\n                scanMap()\n                break\n            end\n            attempts = attempts + 1\n        end\n    end\nend\n\nif ReplicatedStorage:FindFirstChild(\"CurrentMap\") then\n    -- Never put this into mapConnections so clearESP won't destroy it!\n    ReplicatedStorage.CurrentMap.Changed:Connect(OnNewRound)\nend\n\n-- Initial scan\nscanMap()\n\n-- \9472\9472\9472 Instant Update & Poll Loop \9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\9472\n\nRunService.RenderStepped:Connect(function()\n    for category, cfg in pairs(getgenv().PartsESP) do\n        local enabled    = cfg.Enabled\n        local wasEnabled = lastEnabledState[category]\n        local col        = cfg.HighlightColor\n        local text       = cfg.Text\n\n        if enabled and not wasEnabled then \n            scanMap() \n        end\n        if not enabled and wasEnabled then \n            clearCategory(category) \n        end\n        lastEnabledState[category] = enabled\n\n        if enabled then\n            local colorChanged = (col ~= lastColor[category])\n            local textChanged  = (text ~= lastText[category])\n\n            if colorChanged or textChanged then\n                lastColor[category] = col\n                lastText[category]